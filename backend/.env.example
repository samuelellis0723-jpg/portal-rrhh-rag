NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bosque_claro_dev
DB_USER=bosque_claro_app
DB_PASSWORD=
# Alternativas opcionales para contraseñas con caracteres especiales; son secretos igualmente.
DB_PASSWORD_BASE64=
# Opcional: conexión por socket en vez de TCP
DB_SOCKET_PATH=
DB_MIGRATION_USER=bosque_claro_migrator
DB_MIGRATION_PASSWORD=
DB_MIGRATION_PASSWORD_BASE64=
DB_TEST_NAME=bosque_claro_test
DB_CONNECT_TIMEOUT_MS=5000
# Necesarias solo al ejecutar seeders. No usar datos/contraseñas reales.
DEMO_COLABORADOR_PASSWORD=
DEMO_RRHH_PASSWORD=
# Autenticación HTTP: origen(s) explícitos separados por coma y secreto de al menos 32 bytes.
# Conservar estos valores si ya existe .env. Nunca copiar este ejemplo encima.
ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=bosque_claro_sid
SESSION_TTL_HOURS=8
CSRF_SECRET=
# Ingesta: una sola carpeta autorizada, hijos directos; no recorrer Drive completo.
GOOGLE_DRIVE_FOLDER_ID=
# Ruta absoluta a JSON de servicio/OAuth ADC. La cuenta lectora solo necesita Drive readonly.
GOOGLE_APPLICATION_CREDENTIALS=
# Solo publicador manual: credencial separada con escritura en la carpeta; nunca la usa el agente.
GOOGLE_PUBLISH_APPLICATION_CREDENTIALS=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bosque_claro_politicas
# Proveedores implementados: openai o gemini. Completar modelo/dimensión compatibles con tu acceso.
# INGEST_* tiene prioridad; si está vacío se reutilizan los AI_* equivalentes de abajo.
INGEST_EMBEDDING_PROVIDER=
INGEST_EMBEDDING_API_KEY=
INGEST_EMBEDDING_MODEL=
INGEST_EMBEDDING_DIMENSION=
INGEST_EMBEDDING_BATCH_SIZE=32
# Fragmentos por caracteres, con solapamiento; no son un contador exacto de tokens.
INGEST_CHUNK_SIZE=3200
INGEST_CHUNK_OVERLAP=400
INGEST_MIN_TEXT_CHARS=80
INGEST_MAX_DOWNLOAD_BYTES=20971520
INGEST_LEASE_SECONDS=900
# IA genérica: el LLM se integrará en otra etapa. Estas variables también permiten reutilizar embeddings.
AI_PROVIDER=
AI_API_KEY=
AI_LLM_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSION=
# LLM independiente. Conservar AI_*/INGEST_* de Gemini para embeddings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=45000
DEEPSEEK_MAX_TOKENS=1200
POLICY_MIN_SCORE=0.35
CHAT_RATE_LIMIT_PER_MINUTE=30
